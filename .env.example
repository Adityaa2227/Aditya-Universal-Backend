# Server Environment
NODE_ENV=development
PORT=5000

# MongoDB Atlas Database URI
# Example: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/aditya-backend?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/aditya-backend

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list or * for all in development)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
