# Server Environment
NODE_ENV=development
PORT=5000

# MongoDB Atlas Database URI
# Example: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/aditya-backend?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# CORS Allowed Origins (* or comma-separated list)
CORS_ORIGINS=*

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# AI Form Filler - Multi-Level AI Fallback Configuration
# Providers cascade: Groq -> Cerebras -> OpenRouter -> Gemini
# Add at least one API key to enable AI form filling.
# =============================================================================

# 1. Groq (Get free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# 2. Cerebras Cloud (Get free key: https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-70b

# 3. OpenRouter (Get free key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4. Google Gemini (Get free key: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Portfolio module (adityaagarwalportfolio.vercel.app) - optional; /api/v1/portfolio answers 503 without the first two
PORTFOLIO_MONGODB_URI=mongodb+srv://<user>:<password>@<portfolio-cluster>.mongodb.net/
PORTFOLIO_JWT_SECRET=<long-random-string>
PORTFOLIO_ADMIN_EMAIL=you@example.com
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Brevo transactional email (preferred over SMTP when set)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
